# streetworks credentials template
#
# Copy this file to `.env` and fill in what you have. Every provider is
# optional - the quickstart and smoke test skip anything left blank.
# `.env` is gitignored; never commit real credentials.

# --- Street Manager (DfT) --------------------------------------------------
# Register: https://department-for-transport-streetmanager.github.io/street-manager-docs/
# SM_ENV: sandbox (default) or production
SM_EMAIL=
SM_PASSWORD=
SM_ENV=sandbox

# --- Geoplace DataVIA -------------------------------------------------------
# Basic auth (most accounts):
DATAVIA_USER=
DATAVIA_PASSWORD=
# ...or OAuth2 client credentials instead:
# DATAVIA_CLIENT_ID=
# DATAVIA_CLIENT_SECRET=
# A USRN you can see (used by the quickstart street lookup):
DATAVIA_USRN=

# --- D-TRO (DfT Digital Traffic Regulation Orders) ---------------------------
# Free consumer account: https://dtro-ui.dft.gov.uk (issues PRODUCTION creds)
# API Key -> DTRO_CLIENT_ID, API Secret -> DTRO_CLIENT_SECRET
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=
DTRO_APP_ID=
# integration (default) or production. Consumer-portal accounts are
# production; reads there also need: STREETWORKS_ALLOW_PRODUCTION=1
DTRO_ENV=
# STREETWORKS_ALLOW_PRODUCTION=1

# --- SRWR Open Data (Scotland) -----------------------------------------------
# No credentials required. Optionally point at an already-downloaded archive
# so the tools parse locally instead of downloading:
# SRWR_ARCHIVE=

# --- OS Open USRN -------------------------------------------------------------
# No credentials required. The GeoPackage is ~300 MB; after downloading it
# once (see examples/openusrn_lookup.py), point here to enable local lookups:
# OPENUSRN_GPKG=osopenusrn_202607.gpkg
# OPENUSRN_TEST_USRN=33909869

# --- Street Manager Open Data (SNS push) --------------------------------------
# No credentials required - it's a push feed; you host the HTTPS endpoint.
# See examples/opendata_fastapi.py

# --- National Highways API -----------------------
# Free account at https://developer.data.nationalhighways.co.uk create a "Subscription" for API keys.
NH_SUBSCRIPTION_KEY=

# --- Statens vegvesen (Norway, DATEX II roadworks) ---------------------------
# PHASE 2 CONFIRMED (2026-07-30) - see streetworks.datex2.vegvesen. Free;
# request access: https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/
# Ask for the "Road traffic information" publication (nationwide - roadworks,
# closures, accidents, weather events). Registration issues a username and
# password (HTTP Basic - confirmed correct). No IP allow-listing needed.
# Licence: NLOD - credit the Norwegian Public Roads Administration
# (NPRA/Statens vegvesen) as source.
# Real coordinates are MIXED CRS within the same feed (~76% UTM zone
# 33N/EPSG:25833, ~24% WGS84) - resolved per-record; use
# streetworks.common.from_vegvesen (not from_datex2 directly) to get an
# honest Coordinate.crs for every point, see module docstring.
VEGVESEN_USERNAME=
VEGVESEN_PASSWORD=
# ...or Bearer token instead, if that's what's issued:
# VEGVESEN_TOKEN=

# --- Trafikverket (Sweden, roadworks-relevant deviations) ---------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.trafikverket. Free
# self-service registration: https://data.trafikverket.se/ (or via Trafiklab:
# https://www.trafiklab.se/api/other-apis/trafikverket/) - fill the form,
# accept the licence, verify email, get an API key immediately - the
# lightest-weight access model of any Credentials-wanted provider in this
# SDK. Licence: CC0 1.0 Universal (Public Domain Dedication).
# Not vanilla DATEX II - Trafikverket's own XML-request/JSON-response
# envelope (see module docstring). The real MessageType/MessageCode value
# for roadworks is unconfirmed, so iter_roadworks() honestly returns
# nothing until a credentialed pull confirms it - inspect record_type
# yourself via iter_situations() in the meantime and please report back
# what you find (see module docstring's linked issue).
TRAFIKVERKET_API_KEY=

# --- Vejdirektoratet (Denmark, DATEX II 3.2 roadworks) ------------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.vejdirektoratet.
# Registration via Dataudveksleren: https://du-portal-ui.dataudveksler.app.vd.dk/
# Registration issues HTTP Basic Auth username/password AND the actual
# per-dataset pull URL - there is no public data endpoint to hardcode, so
# all three must come from your own registration. Licence: CC BY 4.0 -
# credit Vejdirektoratet (the Danish Road Directorate) as source.
VEJDIREKTORATET_URL=
VEJDIREKTORATET_USERNAME=
VEJDIREKTORATET_PASSWORD=

# --- ASFINAG (Austria, DATEX II roadworks) -------------------------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.austria. Even less
# confirmed than Vejdirektoratet: registration via the ASFINAG Content
# Portal (https://contentportal.asfinag.at/) issues the real pull URL, but
# the auth mechanism itself (API key? Basic Auth? Bearer token?) isn't
# stated anywhere public - report back what you find (see module
# docstring's linked issue). Licence: CC-BY-4.0 plus supplementary
# conditions - credit ASFINAG and disclose your own downstream services to
# them, see the module docstring.
ASFINAG_BASE_URL=

# --- TfNSW Live Traffic Hazards (New South Wales, Australia roadworks) --------
# PHASE 2 CONFIRMED (2026-07-30) - see streetworks.au.nsw. Free, self-service
# registration on the TfNSW API Gateway: https://opendata.transport.nsw.gov.au/
# Authorization header is "apikey <key>" (confirmed correct - this is the
# default). Endpoint paths are "roadwork/open"-style (a real bug found and
# fixed here - the Developer Guide itself documents a different, wrong,
# filename convention). Licence: CC BY 4.0 - credit Transport for NSW as
# source.
NSW_LIVETRAFFIC_API_KEY=

# --- DTP Planned Disruptions - Road (Victoria, Australia roadworks) -----------
# PHASE 2 CONFIRMED (2026-07-30) - see streetworks.au.vic. Free subscription
# key via the Transport Victoria Open Data Hub: https://opendata.transport.vic.gov.au/
# Sent as a "KeyID" header - confirmed correct, NOT the OpenAPI spec's own
# advertised "Ocp-Apim-Subscription-Key"/"subscription-key" scheme (a live
# probe proved the real gateway ignores that one). Licence: CC BY 4.0 -
# credit the Department of Transport and Planning as source.
VIC_DISRUPTIONS_API_KEY=

# --- QLDTraffic Events (TMR, Queensland, Australia roadworks) -----------------
# CONFIRMED LIVE (2026-08-01) - see streetworks.au.qld. No credentials needed
# at all: a real, globally-shared public API key is baked into the client as
# its default (rate-limited 100 req/min, shared across every anonymous
# consumer of the API worldwide). Only set this if you've registered your own
# private key (email QLDTraffic@tmr.qld.gov.au) to avoid contending for the
# shared quota - entirely optional otherwise. Licence: CC BY 4.0 AU.
QLD_QLDTRAFFIC_API_KEY=

# --- Traffic SA / DIT Roadworks (South Australia, Australia roadworks) --------
# PENDING LIVE VERIFICATION - see streetworks.au.sa. Genuinely blocked on TWO
# access gates, not just a credential wait: the query endpoint needs an
# ArcGIS token from location.sa.gov.au/arcgis/tokens/ (whether that's
# self-service or requires a data agreement with DIT is itself unresolved -
# the token host has never been reached), and maps.sa.gov.au CloudFront-blocks
# some countries' network egress outright, independent of any token. No real
# feature has ever been retrieved. Licence: CC BY 4.0.
SA_TRAFFICSA_TOKEN=

# --- NZTA Highway Information / LINZ NZ Addresses (New Zealand) ---------------
# Both CONFIRMED LIVE (2026-08-02) - see streetworks.nzta / streetworks.linz.
# No credentials required for either.

# --- LINZ NZ Addresses: Roads/Road Sections (New Zealand streets) -------------
# PENDING LIVE VERIFICATION - see streetworks.linz.client. Genuinely blocked on
# a real LINZ Data Service (LDS) API key: free self-service registration at
# https://data.linz.govt.nz/ (create a "Data access only" key). NZ Addresses
# itself (above) needs no key at all - only this streets counterpart does.
# Licence: CC BY 4.0.
LINZ_API_KEY=

# --- UK Police (worker-safety signal) -----------------------------------------
# No credentials required. Optionally override the quickstart/smoke-test probe
# point (defaults to Westminster, London):
# POLICE_LAT=51.500617
# POLICE_LNG=-0.124629

# --- WZDx (US Work Zone Data Exchange) -----------------------------------------
# No credentials required. Defaults to Washington State DOT's feed; optionally
# point the quickstart/smoke-test at a different agency instead - see
# streetworks.wzdx.list_feeds() for the full USDOT registry:
# WZDX_FEED_URL=https://wzdx.wsdot.wa.gov/api/v4/WorkZoneFeed

# --- 511 Alberta (Canada roadworks) --------------------------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - Alberta's own real endpoint requires a developer key. Free
# self-service registration: https://511.alberta.ca/developers/doc
ALBERTA_511_API_KEY=

# --- Saskatchewan Highway Hotline (Canada roadworks) ----------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - Saskatchewan's own real endpoint still requires a developer key
# (confirmed live 2026-08-21), but the public self-service signup page
# (https://hotline.gov.sk.ca/developers/doc) has since been taken down -
# no working route to a key found as of 2026-08-21. Set this if you obtain
# one some other way (e.g. contacting the Ministry of Highways directly).
SASKATCHEWAN_511_API_KEY=

# --- New Brunswick 511 (Canada roadworks) ---------------------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - New Brunswick's own real endpoint requires a developer key. Free
# self-service registration: https://511.gnb.ca/developers/doc
NEW_BRUNSWICK_511_API_KEY=

# --- Newfoundland and Labrador 511 (Canada roadworks) ---------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - NL's own real endpoint requires a developer key. Free self-service
# registration: https://511nl.ca/developers/doc
NEWFOUNDLAND_511_API_KEY=

# --- Nova Scotia 511 (Canada roadworks) -----------------------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - Nova Scotia's own real endpoint still requires a developer key
# (confirmed live 2026-08-21), but like Saskatchewan the public developer
# docs/signup page has been taken down (/developers/doc 404s, /developers
# redirects to /notfound) - no working self-service route to a key found.
# Set this if you obtain one some other way.
NOVA_SCOTIA_511_API_KEY=

# --- 511 Yukon (Canada roadworks) -----------------------------------------------
# PENDING LIVE VERIFICATION - see streetworks.na511.client. Same commercial
# 511 platform as Ontario 511 (streetworks.na511, keyless, already verified
# live) - Yukon's own real endpoint requires a developer key. Free
# self-service registration: https://511yukon.ca/developers/doc
YUKON_511_API_KEY=
