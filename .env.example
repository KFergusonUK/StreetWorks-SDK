# streetworks credentials template
#
# Copy this file to `.env` and fill in what you have. Every provider is
# optional - the quickstart and smoke test skip anything left blank.
# `.env` is gitignored; never commit real credentials.

# --- Street Manager (DfT) --------------------------------------------------
# Register: https://department-for-transport-streetmanager.github.io/street-manager-docs/
# SM_ENV: sandbox (default) or production
SM_EMAIL=
SM_PASSWORD=
SM_ENV=sandbox

# --- Geoplace DataVIA -------------------------------------------------------
# Basic auth (most accounts):
DATAVIA_USER=
DATAVIA_PASSWORD=
# ...or OAuth2 client credentials instead:
# DATAVIA_CLIENT_ID=
# DATAVIA_CLIENT_SECRET=
# A USRN you can see (used by the quickstart street lookup):
DATAVIA_USRN=

# --- D-TRO (DfT Digital Traffic Regulation Orders) ---------------------------
# Free consumer account: https://dtro-ui.dft.gov.uk (issues PRODUCTION creds)
# API Key -> DTRO_CLIENT_ID, API Secret -> DTRO_CLIENT_SECRET
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=
DTRO_APP_ID=
# integration (default) or production. Consumer-portal accounts are
# production; reads there also need: STREETWORKS_ALLOW_PRODUCTION=1
DTRO_ENV=
# STREETWORKS_ALLOW_PRODUCTION=1

# --- SRWR Open Data (Scotland) -----------------------------------------------
# No credentials required. Optionally point at an already-downloaded archive
# so the tools parse locally instead of downloading:
# SRWR_ARCHIVE=

# --- OS Open USRN -------------------------------------------------------------
# No credentials required. The GeoPackage is ~300 MB; after downloading it
# once (see examples/openusrn_lookup.py), point here to enable local lookups:
# OPENUSRN_GPKG=osopenusrn_202607.gpkg
# OPENUSRN_TEST_USRN=33909869

# --- Street Manager Open Data (SNS push) --------------------------------------
# No credentials required - it's a push feed; you host the HTTPS endpoint.
# See examples/opendata_fastapi.py

# --- National Highways API -----------------------
# Free account at https://developer.data.nationalhighways.co.uk create a "Subscription" for API keys.
NH_SUBSCRIPTION_KEY=

# --- Statens vegvesen (Norway, DATEX II roadworks) ---------------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.vegvesen. Free; request
# access: https://www.vegvesen.no/en/fag/technology/open-data/a-selection-of-open-data/what-is-datex/get-access/
# Ask for the "Road traffic information" publication (nationwide - roadworks,
# closures, accidents, weather events). Registration issues a username and
# password (not an API key). Licence: NLOD - credit the Norwegian Public
# Roads Administration (NPRA/Statens vegvesen) as source.
# Before assuming the adapter is broken: check which DATEX version your
# credentials actually serve. This client targets v3.1
# (datex-server-get-v3-1.atlas.vegvesen.no, live since 2023-02-01); data.norge.no's
# own catalogue still describes the service as v2.0 with older services
# running in parallel pending phase-out - if that's what you're issued, the
# scaffold is pointed at the wrong version/endpoint, not necessarily wrong.
VEGVESEN_USERNAME=
VEGVESEN_PASSWORD=
# ...or Bearer token instead, if that's what's issued:
# VEGVESEN_TOKEN=

# --- Trafikverket (Sweden, roadworks-relevant deviations) ---------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.trafikverket. Free
# self-service registration: https://data.trafikverket.se/ (or via Trafiklab:
# https://www.trafiklab.se/api/other-apis/trafikverket/) - fill the form,
# accept the licence, verify email, get an API key immediately - the
# lightest-weight access model of any Credentials-wanted provider in this
# SDK. Licence: CC0 1.0 Universal (Public Domain Dedication).
# Not vanilla DATEX II - Trafikverket's own XML-request/JSON-response
# envelope (see module docstring). The real MessageType/MessageCode value
# for roadworks is unconfirmed, so iter_roadworks() honestly returns
# nothing until a credentialed pull confirms it - inspect record_type
# yourself via iter_situations() in the meantime and please report back
# what you find (see module docstring's linked issue).
TRAFIKVERKET_API_KEY=

# --- Vejdirektoratet (Denmark, DATEX II 3.2 roadworks) ------------------------
# PENDING LIVE VERIFICATION - see streetworks.datex2.vejdirektoratet.
# Registration via Dataudveksleren: https://du-portal-ui.dataudveksler.app.vd.dk/
# Registration issues HTTP Basic Auth username/password AND the actual
# per-dataset pull URL - there is no public data endpoint to hardcode, so
# all three must come from your own registration. Licence: CC BY 4.0 -
# credit Vejdirektoratet (the Danish Road Directorate) as source.
VEJDIREKTORATET_URL=
VEJDIREKTORATET_USERNAME=
VEJDIREKTORATET_PASSWORD=

# --- TfNSW Live Traffic Hazards (New South Wales, Australia roadworks) --------
# PENDING LIVE VERIFICATION - see streetworks.au.nsw. Free, self-service
# registration on the TfNSW API Gateway: https://opendata.transport.nsw.gov.au/
# The exact Authorization header format is unconfirmed (the 42-page Developer
# Guide never states it) - this scaffold defaults to "apikey <key>", override
# via NswLiveTrafficClient(header_format=...) if that's wrong. Licence: CC BY
# 4.0 - credit Transport for NSW as source.
NSW_LIVETRAFFIC_API_KEY=

# --- DTP Planned Disruptions - Road (Victoria, Australia roadworks) -----------
# PENDING LIVE VERIFICATION - see streetworks.au.vic. More speculative than
# NSW - no real sample has ever been obtained anywhere. Free subscription key
# via the Transport Victoria Open Data Hub: https://opendata.transport.vic.gov.au/
# Sent as a "KeyID" header - NOT the OpenAPI spec's own advertised
# "Ocp-Apim-Subscription-Key"/"subscription-key" scheme, which a live probe
# confirmed the real gateway ignores (see module docstring). Licence: CC BY
# 4.0 - credit the Department of Transport and Planning as source.
VIC_DISRUPTIONS_API_KEY=

# --- UK Police (worker-safety signal) -----------------------------------------
# No credentials required. Optionally override the quickstart/smoke-test probe
# point (defaults to Westminster, London):
# POLICE_LAT=51.500617
# POLICE_LNG=-0.124629

# --- WZDx (US Work Zone Data Exchange) -----------------------------------------
# No credentials required. Defaults to Washington State DOT's feed; optionally
# point the quickstart/smoke-test at a different agency instead - see
# streetworks.wzdx.list_feeds() for the full USDOT registry:
# WZDX_FEED_URL=https://wzdx.wsdot.wa.gov/api/v4/WorkZoneFeed
